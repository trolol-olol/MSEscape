	"templates": {
		"merchant": {
			"name": "$(name)",
			"text": "$(text)",
			"choices": [
				{
					"type": "multi",
					"category": "sells",
					"text": "КУПИТЬ $(sells.amount)x $(sells.item) ЗА $(sells.price) ПАКЕТИК$(sells.ending)",
					"result": {
						"text": "$(thx_text)",
						"type": "get-remove-item",
						"get_item": "$(sells.item)",
						"get_amount": "$(sells.amount)",
						"remove_item": "ЧАЙНЫЙ ПАКЕТИК",
						"remove_amount": "$(sells.price)"
					},
					"condition": {"type": "has-item", "item": "ЧАЙНЫЙ ПАКЕТИК", "amount": "$(sells.price)"}
				},
				{
					"type": "multi",
					"category": "buys",
					"text": "ПРОДАТЬ $(buys.amount)x $(buys.item) ЗА $(buys.price) ПАКЕТИК$(buys.ending)",
					"result": {
						"text": "$(thx_text)",
						"type": "get-remove-item",
						"get_item": "ЧАЙНЫЙ ПАКЕТИК",
						"get_amount": "$(buys.price)",
						"remove_item": "$(buys.item)",
						"remove_amount": "$(buys.amount)"
					},
					"condition": {"type": "has-item", "item": "$(buys.item)", "amount": "$(buys.amount)"}
				},
				{
					"type": "single",
					"text": "$(exit_text)",
					"result": {
						"text": "$(exit_text_result)",
						"type": "goto",
						"goto": "$(location)"
					}
				}
			]
		},
		"dialog": {
			"name": "$(name)",
			"text": "$(text)",
			"choices": [
				{
					"type": "multi",
					"category": "idk",
					"text": "$(idk.player)",
					"result": {
						"text": "$(idk.answer)",
						"type": "none"
					}
				},
				{
					"type": "single",
					"text": "$(bye_player)",
					"result": {
						"text": "$(bye_text)",
						"type": "goto",
						"goto": "$(location)"
					}
				}
			]
		}
	},
